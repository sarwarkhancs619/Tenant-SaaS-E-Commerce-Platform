datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  name         String
  role         String      @default("OWNER") // OWNER, ADMIN, STAFF
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  
  // Relations
  tenantId     String?
  tenant       Tenant?     @relation(fields: [tenantId], references: [id])
  auditLogs    AuditLog[]
}

model Tenant {
  id           String      @id @default(uuid())
  name         String
  slug         String      @unique // for tenant.platform.com subdomains
  customDomain String?     @unique // e.g. store.custom.com
  category     String      // e.g. Bakery, Clothing, Restaurant, etc.
  logoUrl      String?
  description  String?
  email        String
  phone        String?
  whatsapp     String?
  address      String?
  city         String?
  state        String?
  country      String?
  currency     String      @default("USD")
  language     String      @default("en")
  timezone     String      @default("UTC")
  taxRate      Float       @default(0.0)
  themeSettings String     // JSON string: colors, typography, theme preferences
  enabledFeatures String   // JSON string: list of features enabled (loyalty, reviews, etc.)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  users        User[]
  products     Product[]
  categories   Category[]
  orders       Order[]
  customers    Customer[]
  pages        StorePage[]
  coupons      Coupon[]
  warehouses   Warehouse[]
  auditLogs    AuditLog[]
}

model Category {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  imageUrl    String?
  createdAt   DateTime  @default(now())
  
  products    Product[]

  @@unique([tenantId, slug])
}

model Product {
  id          String      @id @default(uuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id])
  name        String
  slug        String
  description String
  price       Float
  comparePrice Float?
  images      String      // Stored as JSON string (array of image URLs)
  sku         String?
  barcode     String?
  status      String      @default("ACTIVE") // ACTIVE, DRAFT, ARCHIVED
  type        String      @default("PHYSICAL") // PHYSICAL, DIGITAL, SERVICE
  variants    String?     // JSON string: variants config (sizes, colors, stock)
  seoTitle    String?
  seoDesc     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  reviews     Review[]
  orderItems  OrderItem[]
  inventory   InventoryItem[]

  @@unique([tenantId, slug])
}

model Warehouse {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  
  inventory InventoryItem[]
}

model InventoryItem {
  id          String    @id @default(uuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity    Int       @default(0)
  lowStockThreshold Int @default(5)
  updatedAt   DateTime  @updatedAt

  @@unique([productId, warehouseId])
}

model Customer {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String?  // Optional for guest checkout
  name         String
  phone        String?
  walletBalance Float   @default(0.0)
  rewardPoints Int      @default(0)
  createdAt    DateTime @default(now())

  // Relations
  orders       Order[]
  reviews      Review[]

  @@unique([tenantId, email])
}

model Order {
  id             String      @id @default(uuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?   @relation(fields: [customerId], references: [id])
  orderNumber    String
  status         String      @default("PENDING") // PENDING, CONFIRMED, SHIPPED, DELIVERED, CANCELLED, REFUNDED
  total          Float
  subtotal       Float
  tax            Float
  shippingFee    Float
  shippingAddress String     // Stored as JSON string (address properties)
  paymentMethod  String      // stripe, paypal, cod, bank_transfer, etc.
  paymentStatus  String      @default("PENDING") // PENDING, PAID, REFUNDED
  trackingNumber String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  items          OrderItem[]

  @@unique([tenantId, orderNumber])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model StorePage {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title     String
  slug      String
  sections  String   // JSON string representing sections config
  isHome    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
}

model Coupon {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code       String
  discount   Float    // percentage or flat amount
  type       String   // PERCENTAGE or FIXED
  expiresAt  DateTime
  active     Boolean  @default(true)

  @@unique([tenantId, code])
}

model Review {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String
  createdAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())
}
